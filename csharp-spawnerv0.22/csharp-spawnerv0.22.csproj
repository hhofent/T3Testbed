<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>csharp_spawnerv0._1</RootNamespace>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AssemblyName>csharp-spawnerv0.22</AssemblyName>
    <Version>0.22.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="CsharpSpawner\CsharpSpawner.csproj" />
    <Compile Remove="CsharpSpawner/**/*.cs" />
    <Compile Remove="CsharpSpawner.Tests/**/*.cs" />
  </ItemGroup>
</Project>



